{
  "name": "mathwordle",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "wrangler dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "db:create": "wrangler d1 create mathwordle",
    "db:migrate:local": "wrangler d1 execute mathwordle --local --file=migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute mathwordle --remote --file=migrations/0001_init.sql"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "vite": "^5.4.2",
    "wrangler": "^3.72.0"
  }
}
